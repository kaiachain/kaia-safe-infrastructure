REVERSE_PROXY_PORT=8000

# Pinned aligned releases — `latest` can mix incompatible Web (/v2/chains) + old Config (no v2 API).
CFG_VERSION=v2.94.2
CGW_VERSION=v1.109.0
TXS_VERSION=v6.3.0
UI_VERSION=v1.88.0
EVENTS_VERSION=v1.3.0

# RPC endpoint for the target chain (Kaia Kairos testnet example below).
# Used by TXS to index the chain and by CGW/CFG for chain config.
RPC_NODE_URL=https://public-en-kairos.node.kaia.io
